# =========================================================
# Triple N — EAS Build Ignore
# =========================================================

# Dependencies
node_modules/

# Expo local files
.expo/
.expo-shared/

# Native folders generated by Expo Prebuild
/ios/
/android/

# Local environment files
.env
.env.*
!.env.example

# Python local environment and cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Python conversion scripts
convert_birefnet_fp16.py

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Testing and temporary files
coverage/
tmp/
temp/
*.tmp
*.temp

# Git
.git/
.gitignore

# Documentation not required by the native build
AGENTS.md
CLAUDE.md

# =========================================================
# BiRefNet models
# =========================================================

# Exclude unused, broken, temporary and backup models
assets/models/birefnet_full_1024_fp32_backup.db
assets/models/birefnet_full_1024_fp16_broken.db
assets/models/birefnet_full_1024_fp16.db
assets/models/birefnet_full_1024_fp16_v2.db
assets/models/*.tmp.db

# IMPORTANT:
# Keep the active FP16 model inside the EAS Build archive.
!assets/
!assets/models/
!assets/models/birefnet_full_1024.db